# syntax=docker/dockerfile:1.7
# Build context is the repository root:  docker build -f docker/Dockerfile.worker .
ARG NODE_VERSION=22
ARG PNPM_VERSION=11.22.0

FROM node:${NODE_VERSION}-alpine AS base
ARG PNPM_VERSION
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    CI=true \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0 \
    TURBO_TELEMETRY_DISABLED=1
RUN apk add --no-cache libc6-compat openssl \
 && npm install -g corepack@latest \
 && corepack enable \
 && corepack prepare pnpm@${PNPM_VERSION} --activate
WORKDIR /app

FROM base AS deps
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/shared/package.json packages/shared/
COPY packages/database/package.json packages/database/index.js packages/database/index.d.ts packages/database/
COPY prisma ./prisma
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile

FROM deps AS build
COPY . .
RUN pnpm db:generate \
 && pnpm turbo run build --filter=@acsp/worker...

FROM node:${NODE_VERSION}-alpine AS runner
ENV NODE_ENV=production \
    WORKER_HEALTH_PORT=4001
RUN apk add --no-cache libc6-compat openssl wget \
 && addgroup -S app && adduser -S app -G app
WORKDIR /app
COPY --from=build --chown=app:app /app/package.json /app/pnpm-workspace.yaml ./
COPY --from=build --chown=app:app /app/node_modules ./node_modules
COPY --from=build --chown=app:app /app/packages ./packages
COPY --from=build --chown=app:app /app/prisma ./prisma
COPY --from=build --chown=app:app /app/apps/worker/package.json ./apps/worker/package.json
COPY --from=build --chown=app:app /app/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=build --chown=app:app /app/apps/worker/dist ./apps/worker/dist
USER app
EXPOSE 4001
CMD ["node", "apps/worker/dist/main.js"]
