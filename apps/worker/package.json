{
  "name": "@acsp/worker",
  "version": "0.1.0",
  "private": true,
  "description": "BullMQ background worker: AI agents (research, SEO, writing, quality) and job processors.",
  "main": "dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@acsp/database": "workspace:*",
    "@acsp/shared": "workspace:*",
    "bullmq": "^5.58.0",
    "cheerio": "^1.1.2",
    "dotenv": "^17.2.2",
    "ioredis": "^6.0.0",
    "openai": "^5.20.0",
    "pino": "^9.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "eslint": "^9.35.0",
    "pino-pretty": "^13.1.1",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.43.0",
    "vitest": "^3.2.4"
  }
}
